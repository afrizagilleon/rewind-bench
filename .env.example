# Rewind-Bench — copy to .env and fill in.
# Rewind drives a running zaatool instance (https://github.com/afrizagilleon/zaatool)
# and does not modify it. See API-REFERENCE.md for why two tokens are needed.

# The zaatool engine. Not the Vite dev server on :5173 — that is the frontend,
# which proxies /api here anyway.
ZAA_BASE_URL=http://localhost:4000

# REST auth. /api/* verifies a session JWT; an agent token is rejected there.
# Browser → DevTools → Console → localStorage.getItem('zaatool_token')
ZAA_SESSION_TOKEN=

# MCP auth, scope "author". This is the surface a real agent uses, so the
# agentic arms go through it rather than through REST.
ZAA_AGENT_TOKEN=

# Featherless — OpenAI-compatible inference (ImpactForge compute sponsor).
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Subject-under-test models. Every arm runs the SAME model, temperature and seed;
# access to evidence is the only variable allowed to differ.
MODEL_PRIMARY=zai-org/GLM-5.2
MODEL_ALT_1=Qwen/Qwen3-Coder-Next
MODEL_ALT_2=moonshotai/Kimi-K3

DETERMINISM_REPLAYS=10
ARM_TEMPERATURE=0
ARM_SEED=42
RESULTS_DIR=./results
