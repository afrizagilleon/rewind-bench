{
  "name": "rewind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "auth": "node --env-file-if-exists=.env scripts/auth.mjs",
    "mutate": "tsx --env-file-if-exists=.env src/run-mutate.ts",
    "arms": "tsx --env-file-if-exists=.env src/run-arms.ts",
    "metrics": "tsx --env-file-if-exists=.env src/metrics.ts",
    "report": "tsx --env-file-if-exists=.env src/report.ts",
    "demo": "tsx --env-file-if-exists=.env src/run-demo.ts",
    "audit:symptoms": "tsx --env-file-if-exists=.env src/audit-symptoms.ts",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:unit": "vitest run test/client.unit.test.ts test/ledger.test.ts test/msr.test.ts test/determinism.test.ts test/mutate.test.ts test/agent.test.ts test/metrics.test.ts test/report.test.ts test/demo.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5"
  }
}
