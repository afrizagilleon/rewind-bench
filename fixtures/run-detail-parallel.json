      "source": "const results = [inputs.a1, inputs.b1, inputs.b1a, inputs.b2a, inputs.c1, inputs.c2]\n  .filter(Boolean)\n  .sort((x, y) => x.level - y.level || x.lane.localeCompare(y.lane));\n\nconst deepestLevel = results.reduce((m, r) => Math.max(m, r.level), 0);\nconst complete = results.length === 6 && deepestLevel === 3;\n\nconst summary = [\n  `## ${complete ? 'Complete' : 'NOT complete'}`,\n  '',\n  `${results.length} of 6 lanes wrote. Deepest level reached: **${deepestLevel}**.`,\n  '',\n  complete\n    ? 'All three levels ran and their results were merged back.'\n    : \"A lane's write did not arrive. That is a finding — note which lane is missing from the table.\",\n].join('\\n');\n\nreturn { results, summary };",
